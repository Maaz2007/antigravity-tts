# ==============================================================================
# Antigravity Text-to-Speech (TTS) Configuration
# Location: /home/maaz/antigravity-tts/config.env
# ==============================================================================

# TTS Engine Selection:
# "edge"   - Ultra-realistic, 100% human-grade studio neural voice (Best for Hindi/Hinglish/English) [DEFAULT]
# "piper"  - 100% local offline neural engine (fast, works without internet)
# "espeak" - Lightweight legacy formant synthesizer
TTS_ENGINE="edge"

# ------------------------------------------------------------------------------
# Studio Neural Voice Settings (Edge Engine)
# ------------------------------------------------------------------------------
# Available human studio voices:
# - "hi-IN-MadhurNeural" : Male Hindi & Hinglish - natural, warm, human tone (Default)
# - "hi-IN-SwaraNeural"  : Female Hindi & Hinglish - expressive, clear human tone
# - "en-IN-PrabhatNeural": Male Indian English & Hinglish
# - "en-US-GuyNeural"    : Male American English
# - "en-US-AriaNeural"   : Female American English
EDGE_VOICE="hi-IN-MadhurNeural"

# Default base speech speed rate for Edge engine (+0% = 1.0x normal speed)
# Use shortcut <Super><Alt>r to dynamically cycle speed: 1.0x -> 1.25x -> 1.5x -> 1.75x
EDGE_RATE="+0%"

# ------------------------------------------------------------------------------
# Offline Neural Voice Settings (Piper Engine)
# ------------------------------------------------------------------------------
# Available offline voices in ~/antigravity-tts/voices/:
# - "hi_IN-pratham-medium" : Clean Indian Hindi voice (Default offline Hindi)
# - "hi_IN-rohan-medium"   : Expressive Indian Hindi voice
# - "en_US-lessac-medium"  : US Studio voice
# - "en_US-amy-medium"     : Warm natural voice
PIPER_VOICE="hi_IN-pratham-medium"
PIPER_SPEED="0.95"
PIPER_SENTENCE_PAUSE="0.35"
PIPER_NOISE_SCALE="0.75"
PIPER_NOISE_W="0.85"

# ------------------------------------------------------------------------------
# Fallback & Preprocessor Settings
# ------------------------------------------------------------------------------
# Intelligent code, Hinglish, and explanatory pause preprocessor (true / false)
ENABLE_PREPROCESSOR=true

# Automatically fall back to local Piper if internet is disconnected (true / false)
FALLBACK_TO_PIPER=true

# Maximum characters allowed per reading (prevents runaway speech)
MAX_CHARS=25000

# Enable desktop notifications via notify-send (true / false)
ENABLE_NOTIFICATIONS=true

# Selection mode: "primary" (Wayland text selection) or "clipboard" (Ctrl+C)
SELECTION_MODE="primary"
