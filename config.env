# ==============================================================================
# Antigravity Text-to-Speech (TTS) Configuration
# Location: /home/maaz/antigravity-tts/config.env
# ==============================================================================

# TTS Engine Selection:
# "piper"  - High-satisfaction neural voice (studio-quality, natural human prosody) [DEFAULT]
# "espeak" - Lightweight formant synthesizer (robotic)
TTS_ENGINE="piper"

# ------------------------------------------------------------------------------
# Neural Voice Settings (Piper Engine)
# ------------------------------------------------------------------------------
# Available voices located in ~/antigravity-tts/voices/:
# - "en_US-lessac-medium" : Crystal-clear American voice, articulate and natural (Default)
# - "en_US-amy-medium"    : Warm, expressive, natural voice
# - "hi_IN-rohan-medium"   : Native Indian & Bilingual voice (Best for Hinglish & Indian English)
PIPER_VOICE="en_US-lessac-medium"

# Speech speed scale:
# 1.0  = Normal conversational pace
# 0.95 = Snappy, slightly faster (recommended)
# 1.10 = Slower, deliberate pacing
PIPER_SPEED="0.95"

# Sentence silence pause (in seconds) between sentences (default: 0.2)
PIPER_SENTENCE_PAUSE="0.2"

# Expressiveness / pitch variation noise scale (default: 0.667)
PIPER_NOISE_SCALE="0.667"

# Phoneme duration variability (default: 0.8)
PIPER_NOISE_W="0.8"

# Intelligent code & Hinglish pronunciation preprocessor (true / false)
# Converts != to "not equal to", expands snake_case, converts Romanized Hinglish to native phonetics
ENABLE_PREPROCESSOR=true

# ------------------------------------------------------------------------------
# Fallback Settings (eSpeak NG Engine)
# ------------------------------------------------------------------------------
ESPEAK_VOICE="en-us"
ESPEAK_SPEED=175
ESPEAK_PITCH=50
ESPEAK_AMPLITUDE=100

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------
# Maximum characters allowed per reading (prevents runaway speech)
MAX_CHARS=25000

# Enable desktop notifications via notify-send (true / false)
ENABLE_NOTIFICATIONS=true

# Selection mode: "primary" (Wayland text selection) or "clipboard" (Ctrl+C)
SELECTION_MODE="primary"
